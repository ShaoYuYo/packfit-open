     <TextBlock Grid.Column="2" Grid.Row="1" Text="電芯 A 預設不可旋轉限制：目前允許 90° 旋轉；實際極耳方向要人工確認。" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    </Grid>
    <TextBlock Text="候選 Cell B（選填；填齊五個欄位才加入比較）" FontWeight="SemiBold"/>
    <Grid ColumnSpacing="9" RowSpacing="8">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBox x:Name="QuickCellBLength" Grid.Column="0" Grid.Row="0" Header="長 L" TextChanged="QuickLayoutChanged"/>
     <TextBox x:Name="QuickCellBWidth" Grid.Column="1" Grid.Row="0" Header="寬 W" TextChanged="QuickLayoutChanged"/>
     <TextBox x:Name="QuickCellBHeight" Grid.Column="2" Grid.Row="0" Header="厚 H" TextChanged="QuickLayoutChanged"/>
     <TextBox x:Name="QuickCellBCapacity" Grid.Column="0" Grid.Row="1" Header="容量 Ah" TextChanged="QuickLayoutChanged"/>
     <TextBox x:Name="QuickCellBMass" Grid.Column="1" Grid.Row="1" Header="質量 g" TextChanged="QuickLayoutChanged"/>
     <TextBlock Grid.Column="2" Grid.Row="1" Text="不同尺寸先比較幾何可放入性與 Wh；不能假設兩款不同電芯可混接。" TextWrapping="Wrap" FontSize="11" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    </Grid>
    <CheckBox x:Name="QuickAllowRotation" Content="允許電芯 90° 旋轉（僅在極耳、出線及製程允許時勾選）" IsChecked="False" Checked="QuickLayoutOptionChanged" Unchecked="QuickLayoutOptionChanged" AutomationProperties.Name="允許電芯在 XY 平面旋轉九十度"/>
    <TextBlock Text="02 / 拓樸、保留空間與名目目標" FontWeight="SemiBold"/>
    <Grid ColumnSpacing="9" RowSpacing="8">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBox x:Name="QuickSeries" Grid.Column="0" Grid.Row="0" Header="固定串聯數 S" PlaceholderText="例如 3" TextChanged="QuickLayoutChanged"/>
     <TextBox x:Name="QuickParallel" Grid.Column="1" Grid.Row="0" Header="最高並聯數 P" PlaceholderText="例如 2" TextChanged="QuickLayoutChanged"/>
     <TextBox x:Name="QuickNominalV" Grid.Column="2" Grid.Row="0" Header="單顆名目 V" PlaceholderText="例如 3.85" TextChanged="QuickLayoutChanged"/>
     <TextBox x:Name="QuickEdge" Grid.Column="0" Grid.Row="1" Header="四邊預留 mm" PlaceholderText="例如 2" TextChanged="QuickLayoutChanged"/>
     <TextBox x:Name="QuickZReserve" Grid.Column="1" Grid.Row="1" Header="總厚度預留 mm" PlaceholderText="例如 0.8" TextChanged="QuickLayoutChanged"/>
     <TextBox x:Name="QuickCellGap" Grid.Column="2" Grid.Row="1" Header="電芯間距 mm" PlaceholderText="例如 2" TextChanged="QuickLayoutChanged"/>
     <TextBox x:Name="QuickOverhead" Grid.Column="0" Grid.Row="2" Header="非電芯估計 g" PlaceholderText="例如 35" TextChanged="QuickLayoutChanged"/>
     <TextBox x:Name="QuickTargetWh" Grid.Column="1" Grid.Row="2" Header="目標 Wh" PlaceholderText="例如 50" TextChanged="QuickLayoutChanged"/>
    </Grid>
    <TextBlock x:Name="QuickLayoutStatus" Text="尚未提供外框尺寸及候選 Cell 規格。系統外框 L/W/H ≠ 真正無干涉的電池內部可用體積。" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    <Button x:Name="QuickLayoutRunButton" Content="用長寬高找配置方案" Click="QuickLayoutRunClick" Style="{StaticResource AccentButtonStyle}" MinHeight="45" HorizontalAlignment="Left"/>
   </StackPanel>
  </Border>
  <Expander Header="進階模式：不規則 XY 區域、禁放區與 JSON" IsExpanded="False">
   <StackPanel Spacing="12" Padding="4,12,4,4">
    <TextBlock Text="需要描述 L 形與多區域厚度限制時才使用。這些參數無法只靠外框 L/W/H 自動推測。" TextWrapping="Wrap" FontSize="12"/>
    <Button Content="載入完全合成的 L 形空間範例" Click="LoadSyntheticGeometryClick" MinHeight="40" HorizontalAlignment="Left"/>
    <TextBox x:Name="GeometryJsonBox" Header="XY 區域、Keepout、電芯候選與 S/P 組合（JSON，mm）" PlaceholderText="貼上已去識別化的幾何設定，或先載入合成示例" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="150" MaxHeight="250" FontFamily="Consolas" FontSize="12" TextChanged="GeometryJsonChanged" AutomationProperties.Name="編輯不規則空間與電芯幾何 JSON"/>
    <Button x:Name="GeometryRunButton" Content="用進階設定尋找配置" Click="CalculateGeometryClick" MinHeight="42" HorizontalAlignment="Left"/>
   </StackPanel>
  </Expander>
  <ComboBox x:Name="GeometryCandidateChoice" Header="查看候選排列" MinWidth="220" HorizontalAlignment="Stretch" SelectionChanged="GeometryCandidateChanged" AutomationProperties.Name="選擇不規則電池布局候選"/>
  <TextBlock x:Name="GeometrySummary" Text="請載入合成範例或輸入自己的幾何設定，再執行有界排列搜尋。" FontSize="13" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
  <StackPanel x:Name="GeometryMap" Spacing="9"/>
  <TextBlock Text="灰色：可放置區；紅色：禁放區；藍綠色：幾何上已放置的電芯。Wh/L 是名目能量除以全部輸入區域總容積，不是實際 Pack ED。沒有驗證電芯極耳、FPC、PCB、熱與機構可製造性。" TextWrapping="Wrap" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
 </StackPanel>
</Border>
</StackPanel>
                <StackPanel x:Name="ReportPanel" Spacing="20" Visibility="Collapsed"><StackPanel Spacing="8" Margin="0,0,0,12">
<TextBlock Text="05 / REPORTING" Style="{StaticResource PfEyebrowText}" />
<TextBlock Text="工程摘要產生器" Style="{StaticResource PfPageHeading}" />
<TextBlock Text="整合已讀取的數據、驗證結論、使用門檻與複查清單，輸出能供同事審閱的 Markdown。" Style="{StaticResource PfLeadText}" />
</StackPanel><Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="14" Padding="22"><StackPanel Spacing="13"><TextBlock Text="報告內容" Style="{StaticResource PfSectionHeading}" /><TextBlock Text="報告僅包含本次操作中已讀取的資料。會明確列出風險及資料限制，不會宣稱通過安全或認證。" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
<Button x:Name="PreviewReportButton" Content="產生報告預覽" Click="PreviewReportClick"  MinHeight="42" Padding="17,10" /><Button x:Name="ExportReportButton" Content="儲存 Markdown 報告" Click="ExportReportClick" Style="{StaticResource AccentButtonStyle}" MinHeight="42" Padding="17,10" />
<TextBox x:Name="ReportPreview" Header="Preview" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True" Height="450" FontFamily="Consolas" FontSize="12" /></StackPanel></Border></StackPanel>

                
<StackPanel x:Name="VisualsPanel" Spacing="20" Visibility="Collapsed">
 <StackPanel Spacing="8" Margin="0,0,0,12">
  <TextBlock Text="ENGINEERING / DATA VISUALIZATION" Style="{StaticResource PfEyebrowText}"/>
  <TextBlock Text="圖表視覺分析" Style="{StaticResource PfPageHeading}"/>
  <TextBlock Text="容量變化、量測四訊號、拓樸結構與測試結果。同一張圖不混用不同單位；原始數據不會上傳。" Style="{StaticResource PfLeadText}"/>
 </StackPanel>
 <Button Content="載入合成示範資料" HorizontalAlignment="Left" Click="LoadDemoClick" Style="{StaticResource AccentButtonStyle}"/>
 <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="14" Padding="22">
  <StackPanel Spacing="14">
    <TextBlock Text="Battery capacity · 健康與歷史" Style="{StaticResource PfSectionHeading}"/>
    <StackPanel x:Name="VisualsBattery" Spacing="10"/>
  </StackPanel>
 </Border>
 <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="14" Padding="22">
  <StackPanel Spacing="14">
    <TextBlock Text="Telemetry · 電壓／電流／溫度／SOC" Style="{StaticResource PfSectionHeading}"/>
    <StackPanel x:Name="VisualsTelemetry" Spacing="10"/>
  </StackPanel>
 </Border>
 <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="14" Padding="22">
  <StackPanel Spacing="14">
    <TextBlock Text="Pack topology · 串並聯概念圖" Style="{StaticResource PfSectionHeading}"/>
    <StackPanel x:Name="VisualsPack" Spacing="10"/>
