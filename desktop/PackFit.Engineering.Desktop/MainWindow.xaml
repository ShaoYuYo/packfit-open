 </Border>
</StackPanel>
<StackPanel x:Name="SleepPanel" Spacing="20" Visibility="Collapsed">
 <StackPanel Spacing="8" Margin="0,0,0,12">
  <TextBlock Text="WINDOWS / STANDBY INVESTIGATION" Style="{StaticResource PfEyebrowText}"/>
  <TextBlock Text="Sleep &amp; Drain · 待機耗電" Style="{StaticResource PfPageHeading}"/>
  <TextBlock Text="以手動 SOC 起訖、待機時長及容量估算掉電率，再搭配 Windows 睡眠狀態與喚醒來源排查。不是實際功率儀量測。" Style="{StaticResource PfLeadText}"/>
 </StackPanel>
 <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="14" Padding="22">
  <StackPanel Spacing="13">
   <TextBlock Text="1 · 輸入待機前後讀值" Style="{StaticResource PfSectionHeading}"/>
   <TextBox x:Name="SleepStartSoc" Header="開始 SOC (%)" Text="85"/>
   <TextBox x:Name="SleepEndSoc" Header="結束 SOC (%)" Text="77"/>
   <TextBox x:Name="SleepHours" Header="待機時長 (hour)" Text="8"/>
   <TextBox x:Name="SleepCapacityWh" Header="滿充容量 (Wh，可空白)" Text="56"/>
   <Button Content="計算 SOC/hr 與估算 Wh" Click="CalculateSleepClick" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left"/>
   <StackPanel x:Name="SleepGraphCanvas" Spacing="12"/>
  </StackPanel>
 </Border>
 <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="14" Padding="22">
  <StackPanel Spacing="12">
   <TextBlock Text="2 · 建議的 Windows 診斷流程" Style="{StaticResource PfSectionHeading}"/>
   <StackPanel x:Name="SleepFlowCanvas" Spacing="9"/>
