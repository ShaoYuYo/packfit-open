<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="PackFit.Engineering.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="PackFit Engineering">
    <Window.SystemBackdrop>
      <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <TitleBar Grid.Row="0" x:Name="AppTitleBar"
                Title="PackFit Engineering" Subtitle="Battery · Power · Validation"
                IsPaneToggleButtonVisible="True" PaneToggleRequested="AppTitleBar_PaneToggleRequested">
        <TitleBar.IconSource><FontIconSource Glyph="&#xE8FD;" /></TitleBar.IconSource>
      </TitleBar>
      <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="Auto"
          OpenPaneLength="252" IsBackButtonVisible="Collapsed"
          IsPaneToggleButtonVisible="False" IsSettingsVisible="False" SelectionChanged="Navigation_SelectionChanged">
        <NavigationView.MenuItems>
          <NavigationViewItem Content="總覽 / 工作台" Tag="overview"><NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon></NavigationViewItem>
          <NavigationViewItem Content="圖表視覺分析" Tag="visuals"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon></NavigationViewItem>
          <NavigationViewItem Content="待機耗電分析" Tag="sleep"><NavigationViewItem.Icon><FontIcon Glyph="&#xE823;" /></NavigationViewItem.Icon></NavigationViewItem>
          <NavigationViewItem Content="電池健康度" Tag="battery"><NavigationViewItem.Icon><FontIcon Glyph="&#xE7F4;" /></NavigationViewItem.Icon></NavigationViewItem>
          <NavigationViewItem Content="量測 CSV 分析" Tag="telemetry"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon></NavigationViewItem>
          <NavigationViewItem Content="驗證矩陣" Tag="validation"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9D5;" /></NavigationViewItem.Icon></NavigationViewItem>
          <NavigationViewItem Content="電池包估算" Tag="pack"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8FD;" /></NavigationViewItem.Icon></NavigationViewItem>
          <NavigationViewItem Content="工程報告" Tag="report"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8A5;" /></NavigationViewItem.Icon></NavigationViewItem>
          <NavigationViewItemSeparator />
          <NavigationViewItemHeader Content="協助與診斷" />
          <NavigationViewItem Content="問題排查引導" Tag="guide"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9CE;" /></NavigationViewItem.Icon></NavigationViewItem>
          <NavigationViewItem Content="Windows 診斷工具" Tag="diagnostics"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;" /></NavigationViewItem.Icon></NavigationViewItem>
          <NavigationViewItem Content="工具與安裝指南" Tag="resources"><NavigationViewItem.Icon><FontIcon Glyph="&#xE897;" /></NavigationViewItem.Icon></NavigationViewItem>
        </NavigationView.MenuItems>
        <NavigationView.Content>
          <Grid x:Name="WorkspaceRoot" SizeChanged="WorkspaceRoot_SizeChanged" Padding="28,18,28,30">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <InfoBar Grid.Row="0" x:Name="NoticeBar" Title="PackFit" Severity="Informational"
                IsOpen="False" IsClosable="True" Margin="0,0,0,10" />
            <ScrollViewer x:Name="WorkspaceScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="20" MaxWidth="1140" HorizontalAlignment="Stretch">
                <StackPanel x:Name="OverviewPanel" Spacing="20" Visibility="Collapsed"><StackPanel Spacing="8" Margin="0,0,0,12">
<TextBlock Text="ENGINEERING / WORKSPACE" Style="{StaticResource PfEyebrowText}" />
<TextBlock Text="工程工作台" Style="{StaticResource PfPageHeading}" />
<TextBlock Text="筆電電池工程驗證工作台 · 整理資料、標記異常、產生可複查的測試摘要。" Style="{StaticResource PfLeadText}" />
<ComboBox x:Name="ExperienceMode" Header="使用模式 · Basic / Engineering" HorizontalAlignment="Left" MinWidth="230" SelectionChanged="ExperienceModeChanged">
 <ComboBoxItem Tag="basic" Content="Basic · 簡易排查"/>
 <ComboBoxItem Tag="engineering" Content="Engineering · 進階工程"/>
</ComboBox>
</StackPanel>
<Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="18" Padding="22">
 <Grid ColumnSpacing="18">
  <Grid.ColumnDefinitions><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="3"/>
  <StackPanel Grid.Column="1" Spacing="9">
   <TextBlock Text="SESSION / DATA PROVENANCE" Style="{StaticResource PfEyebrowText}"/>
   <TextBlock x:Name="DataModeText" Text="尚未建立分析工作階段" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/>
   <TextBlock x:Name="DataModeDetails" Text="請匯入自己的資料，或使用完全合成的範例試用。計算僅供初步篩選。" Style="{StaticResource PfLeadText}"/>
   <StackPanel x:Name="SessionActions" Orientation="Horizontal" Spacing="10">
    <Button Content="載入合成示範" Click="LoadDemoClick" MinHeight="40"/>
    <Button Content="清除分析資料" Click="ClearWorkspaceClick" MinHeight="40" ToolTipService.ToolTip="清除已匯入、計算和示範數據；輸入設定仍會保留"/>
   </StackPanel>
  </StackPanel>
 </Grid>
</Border>
<Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="14" Padding="22"><StackPanel Spacing="13"><TextBlock Text="常用工作" Style="{StaticResource PfSectionHeading}" /><TextBlock Text="先讀取電池狀態、匯入量測資料，再確認測試門檻。所有運算都在本機執行。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><StackPanel x:Name="QuickActions" Orientation="Horizontal" Spacing="12"><Button x:Name="QuickBattery" Content="產生電池報告" Click="GenerateBatteryClick" Style="{StaticResource AccentButtonStyle}" MinHeight="42" Padding="17,10" /><Button x:Name="QuickTelemetry" Content="匯入量測 CSV" Click="ImportTelemetryClick"  MinHeight="42" Padding="17,10" /><Button x:Name="QuickExport" Content="輸出工程報告" Click="ExportReportClick" MinHeight="42" Padding="17,10" ToolTipService.ToolTip="輸出 Markdown 工程報告 (Ctrl+S)"><Button.KeyboardAccelerators><KeyboardAccelerator Key="S" Modifiers="Control"/></Button.KeyboardAccelerators></Button><Button Content="問題排查引導" Click="GoGuideClick" MinHeight="42" Padding="17,10" /></StackPanel></StackPanel></Border>
<Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="14" Padding="22">
 <StackPanel Spacing="13">
  <TextBlock Text="我今天遇到什麼問題？" Style="{StaticResource PfSectionHeading}" />
  <TextBlock Text="選擇症狀，系統會開啟有理由、有證據需求的排查清單。沒有資料時先試用合成範例。" Style="{StaticResource PfLeadText}"/>
  <StackPanel x:Name="SymptomActions" Orientation="Horizontal" Spacing="9">
    <Button Tag="sleep-drain" Content="待機掉電" Click="GoSymptomClick" />
    <Button Tag="slow-charge" Content="充電慢" Click="GoSymptomClick"/>
    <Button Tag="shutdown" Content="突然關機" Click="GoSymptomClick"/>
    <Button Tag="heat" Content="高溫降頻" Click="GoSymptomClick"/>
    <Button Tag="battery-health" Content="容量衰退" Click="GoSymptomClick"/>
  </StackPanel>
  <Button Content="載入合成示範資料（可立即查看圖表）" Click="LoadDemoClick" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" />
  <StackPanel x:Name="WorkflowDiagram" Spacing="9"/>
 </StackPanel>
</Border>
<Grid x:Name="OverviewStatsGrid" ColumnSpacing="12" RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border x:Name="OverviewStats1" Grid.Column="0" Padding="20" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"><StackPanel><TextBlock Text="BATTERY" Style="{StaticResource PfEyebrowText}"/><TextBlock x:Name="OverviewBattery" Text="尚未分析" Style="{StaticResource PfMetricValue}"/><TextBlock x:Name="OverviewBatterySource" Text="尚無資料" Style="{StaticResource PfLeadText}"/></StackPanel></Border>
<Border x:Name="OverviewStats2" Grid.Column="1" Padding="20" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"><StackPanel><TextBlock Text="TELEMETRY" Style="{StaticResource PfEyebrowText}"/><TextBlock x:Name="OverviewTelemetry" Text="尚未匯入" Style="{StaticResource PfMetricValue}"/><TextBlock x:Name="OverviewTelemetrySource" Text="尚無資料" Style="{StaticResource PfLeadText}"/></StackPanel></Border>
<Border x:Name="OverviewStats3" Grid.Column="2" Padding="20" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"><StackPanel><TextBlock Text="VALIDATION" Style="{StaticResource PfEyebrowText}"/><TextBlock x:Name="OverviewValidation" Text="尚未匯入" Style="{StaticResource PfMetricValue}"/><TextBlock x:Name="OverviewValidationSource" Text="尚無資料" Style="{StaticResource PfLeadText}"/></StackPanel></Border></Grid><Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="14" Padding="22"><StackPanel Spacing="13"><TextBlock Text="專案識別" Style="{StaticResource PfSectionHeading}" /><TextBlock Text="可以填入公開或內部專案代碼；資料只會用於本機產出的報告，不會自動上傳。" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
<TextBox x:Name="ProjectBox" Header="Project / 專案名稱" Text="Sample Battery Project" MinWidth="115" Margin="0,0,10,12" />
<TextBox x:Name="AuthorBox" Header="Engineer / 工程師" Text="" MinWidth="115" Margin="0,0,10,12" /></StackPanel></Border><Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="14" Padding="22"><StackPanel Spacing="13"><TextBlock Text="工具的判斷邊界" Style="{StaticResource PfSectionHeading}" /><TextBlock TextWrapping="Wrap" Text="Pass/Fail 只依據你設定的量測門檻；電池安全、可靠度、機構、電性與認證仍需專業審查。範例數據不代表 HP 或任何供應商標準。" /></StackPanel></Border></StackPanel>
                <StackPanel x:Name="BatteryPanel" Spacing="20" Visibility="Collapsed"><StackPanel Spacing="8" Margin="0,0,0,12">
<TextBlock Text="01 / WINDOWS DIAGNOSTICS" Style="{StaticResource PfEyebrowText}" />
<TextBlock Text="電池健康度" Style="{StaticResource PfPageHeading}" />
<TextBlock Text="一鍵執行 Windows powercfg 電池報告，或者匯入既有的 battery-report.html。" Style="{StaticResource PfLeadText}" />
</StackPanel><Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="14" Padding="22"><StackPanel Spacing="13"><TextBlock Text="讀取本機電池" Style="{StaticResource PfSectionHeading}" /><StackPanel x:Name="BatteryActions" Orientation="Horizontal" Spacing="12"><Button x:Name="PowerCfgButton" Content="在本機建立報告" Click="GenerateBatteryClick" Style="{StaticResource AccentButtonStyle}" MinHeight="42" Padding="17,10" /><Button x:Name="BatteryFileButton" Content="匯入 HTML" Click="ImportBatteryClick"  MinHeight="42" Padding="17,10" /></StackPanel>
<TextBlock Text="powercfg 是 Windows 內建工具；程式只解析容量欄位，不會將報告上傳。" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
<TextBlock x:Name="BatteryResult" Text="尚未讀取。請先執行報告或匯入 HTML。" FontSize="17" TextWrapping="Wrap" FontWeight="SemiBold"/><StackPanel x:Name="BatteryVisualCanvas" Spacing="14"/></StackPanel></Border></StackPanel>
                <StackPanel x:Name="TelemetryPanel" Spacing="20" Visibility="Collapsed"><StackPanel Spacing="8" Margin="0,0,0,12">
<TextBlock Text="02 / TELEMETRY SCREENING" Style="{StaticResource PfEyebrowText}" />
<TextBlock Text="量測紀錄與異常檢查" Style="{StaticResource PfPageHeading}" />
<TextBlock Text="將 CSV 中常見的電壓、電流、溫度與 SOC 資料整理成可追蹤的異常清單。" Style="{StaticResource PfLeadText}" />
</StackPanel><Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="14" Padding="22"><StackPanel Spacing="13"><TextBlock Text="篩選條件" Style="{StaticResource PfSectionHeading}" /><TextBlock Text="溫度預設值僅供範例測試；電壓與電流上下限預設關閉，請依實際機種及電池規格設定。" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
<StackPanel x:Name="TelemetryLimitsPrimary" Orientation="Horizontal" Spacing="10">
<TextBox x:Name="MinTempBox" Header="Temp min (°C)" Text="-20" MinWidth="115" Margin="0,0,10,12" /><TextBox x:Name="MaxTempBox" Header="Temp max (°C)" Text="60" MinWidth="115" Margin="0,0,10,12" />
<TextBox x:Name="MinVoltBox" Header="Pack V min (空白=不判)" Text="" MinWidth="115" Margin="0,0,10,12" /><TextBox x:Name="MaxVoltBox" Header="Pack V max (空白=不判)" Text="" MinWidth="115" Margin="0,0,10,12" />
</StackPanel><StackPanel x:Name="TelemetryLimitsSecondary" Orientation="Horizontal" Spacing="10">
<TextBox x:Name="MaxCurrentBox" Header="Current |A| max (可空白)" Text="" MinWidth="115" Margin="0,0,10,12" />
<TextBox x:Name="MaxSocRateBox" Header="SOC slope %/min" Text="15" MinWidth="115" Margin="0,0,10,12" />
<TextBox x:Name="MaxGapBox" Header="Sample gap (s)" Text="120" MinWidth="115" Margin="0,0,10,12" />
</StackPanel>
<CheckBox x:Name="DischargeSignCheck" Content="正電流表示放電（如量測設備使用負值，取消勾選）" IsChecked="True" />
<StackPanel x:Name="TelemetryFileActions" Orientation="Horizontal" Spacing="10">
  <Button x:Name="TelemetryImportButton" Content="分析 CSV / TSV" Click="ImportTelemetryClick" Style="{StaticResource AccentButtonStyle}" MinHeight="42" Padding="17,10" />
  <Button x:Name="TelemetryBatchButton" Content="批次匯入 CSV / TSV" Click="ImportTelemetryBatchClick" MinHeight="42" Padding="17,10"/>
  <Button Content="取得 Log 範例" Click="SaveTelemetryExampleClick" MinHeight="42" Padding="17,10"/>
</StackPanel>
<TextBlock Text="必要欄位：Timestamp（含時區）；至少再有一個訊號欄位。支援 Voltage_V / Voltage_mV、Current_A / Current_mA、Temp_C、SOC_pct。" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Border><Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="14" Padding="22"><StackPanel Spacing="13"><TextBlock Text="異常摘要" Style="{StaticResource PfSectionHeading}" /><TextBlock x:Name="TelemetryResult" Text="尚未匯入 CSV。" FontSize="14" TextWrapping="Wrap"/>
<TextBox x:Name="FindingFilterBox" Header="搜尋異常（代碼、嚴重度、文字或列號）" PlaceholderText="例如 VOLTAGE_LOW、TEMP_HIGH、Warning" TextChanged="FindingFilter_TextChanged" MaxWidth="520" HorizontalAlignment="Stretch" AutomationProperties.Name="搜尋異常紀錄"/>
<TextBlock x:Name="FindingCodeSummary" Text="匯入資料後顯示完整 Log 各類異常統計。" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
<TextBlock x:Name="FindingPreviewCaption" Text="目前沒有異常明細。" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
<ListView x:Name="TelemetryList" MinHeight="175" MaxHeight="370" SelectionMode="None" AutomationProperties.Name="量測異常預覽清單" /><StackPanel x:Name="TelemetryChartCanvas" Spacing="10"/><Expander Header="批次分析摘要（同一組門檻）" IsExpanded="True">
  <StackPanel Spacing="8" Padding="12">
    <TextBlock Text="最多 12 份 CSV，同時使用上方門檻。只讀取本機資料，不上傳；詳細結果可匯出至工程報告。" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    <ListView x:Name="BatchTelemetryList" MinHeight="90" MaxHeight="240" SelectionMode="None"/>
    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="15" Margin="0,8,0,0">
      <StackPanel Spacing="12">
        <TextBlock Text="A/B 工程比較 · Baseline vs Candidate" Style="{StaticResource PfSectionHeading}"/>
        <TextBlock Text="用同一組門檻比較兩份量測，查看溫度／電壓差異與每千筆樣本的異常率。測試條件不同時，數字不能直接判定產品變好。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
        <ComboBox x:Name="BaselineChoice" Header="基準資料（Before）" MinWidth="230" MaxWidth="460" HorizontalAlignment="Stretch" SelectionChanged="ComparisonSelectionChanged"/>
        <ComboBox x:Name="CandidateChoice" Header="候選資料（After）" MinWidth="230" MaxWidth="460" HorizontalAlignment="Stretch" SelectionChanged="ComparisonSelectionChanged"/>
        <Button x:Name="CompareFilesButton" Content="比較兩份量測" Click="CompareBatchClick" IsEnabled="False" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" MinHeight="42"/>
        <TextBlock x:Name="ComparisonResult" Text="請先批次匯入至少兩份 CSV / TSV。" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="13"/>
        <StackPanel x:Name="ComparisonFlags" Spacing="11"/>
      </StackPanel>
    </Border>
  </StackPanel>
</Expander>
<TextBlock Text="異常清單最多顯示 1,000 筆；報告會註明其餘筆數，方便追查完整原始資料。" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Border></StackPanel>
                <StackPanel x:Name="ValidationPanel" Spacing="20" Visibility="Collapsed"><StackPanel Spacing="8" Margin="0,0,0,12">
<TextBlock Text="03 / TEST MATRIX" Style="{StaticResource PfEyebrowText}" />
<TextBlock Text="測試驗證矩陣" Style="{StaticResource PfPageHeading}" />
<TextBlock Text="讀入測試標準和量測結果，快速歸類 PASS、FAIL、NOT RUN，避免每次手動整理表格。" Style="{StaticResource PfLeadText}" />
</StackPanel><Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="14" Padding="22"><StackPanel Spacing="13"><TextBlock Text="CSV 驗證矩陣" Style="{StaticResource PfSectionHeading}" /><TextBlock Text="輸入欄位：TestID, Category, Metric, Measured, Min, Max, Unit, Owner, Notes。Min / Max 至少填一個；未量測的項目會標為 NOT RUN。" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
<StackPanel x:Name="ValidationFileActions" Orientation="Horizontal" Spacing="10">
<Button x:Name="ValidationImportButton" Content="匯入驗證矩陣 CSV" Click="ImportValidationClick" Style="{StaticResource AccentButtonStyle}" MinHeight="42" Padding="17,10" />
<Button Content="取得測試矩陣範例" Click="SaveValidationExampleClick" MinHeight="42" Padding="17,10"/>
</StackPanel>
<TextBlock x:Name="ValidationResult" Text="尚未匯入。" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
<ListView x:Name="ValidationList" MinHeight="180" MaxHeight="420" SelectionMode="None" /><StackPanel x:Name="ValidationChartCanvas" Spacing="10"/></StackPanel></Border></StackPanel>
                <StackPanel x:Name="PackPanel" Spacing="20" Visibility="Collapsed"><StackPanel Spacing="8" Margin="0,0,0,12">
<TextBlock Text="04 / DESIGN ESTIMATION" Style="{StaticResource PfEyebrowText}" />
<TextBlock Text="電池包設計估算" Style="{StaticResource PfPageHeading}" />
<TextBlock Text="比較串並聯、Wh、外部包絡體積、總重量及能量密度。這是名目估算，不代表實際可製造。" Style="{StaticResource PfLeadText}" />
</StackPanel><Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="14" Padding="22"><StackPanel Spacing="13"><TextBlock Text="電芯與包絡參數" Style="{StaticResource PfSectionHeading}" /><StackPanel x:Name="PackParametersPrimary" Orientation="Horizontal" Spacing="10">
<TextBox x:Name="SeriesBox" Header="Series (S)" Text="3" MinWidth="115" Margin="0,0,10,12" /><TextBox x:Name="ParallelBox" Header="Parallel (P)" Text="1" MinWidth="115" Margin="0,0,10,12" />
<TextBox x:Name="CellVoltageBox" Header="Cell voltage (V)" Text="3.85" MinWidth="115" Margin="0,0,10,12" /><TextBox x:Name="CellCapacityBox" Header="Cell capacity (Ah)" Text="5.0" MinWidth="115" Margin="0,0,10,12" />
</StackPanel><StackPanel x:Name="PackParametersSecondary" Orientation="Horizontal" Spacing="10">
<TextBox x:Name="CellMassBox" Header="Cell mass (g)" Text="57" MinWidth="115" Margin="0,0,10,12" /><TextBox x:Name="OverheadBox" Header="Other mass (g)" Text="65" MinWidth="115" Margin="0,0,10,12" />
<TextBox x:Name="LoadBox" Header="Avg load (W)" Text="16" MinWidth="115" Margin="0,0,10,12" />
</StackPanel><StackPanel x:Name="PackParametersDimensions" Orientation="Horizontal" Spacing="10">
<TextBox x:Name="LengthBox" Header="Length (mm)" Text="240" MinWidth="115" Margin="0,0,10,12" /><TextBox x:Name="WidthBox" Header="Width (mm)" Text="70" MinWidth="115" Margin="0,0,10,12" />
<TextBox x:Name="HeightBox" Header="Thickness (mm)" Text="6.8" MinWidth="115" Margin="0,0,10,12" />
</StackPanel><Button x:Name="PackCalculateButton" Content="計算設計" Click="CalculatePackClick" Style="{StaticResource AccentButtonStyle}" MinHeight="42" Padding="17,10" /></StackPanel></Border><Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="14" Padding="22"><StackPanel Spacing="13"><TextBlock Text="計算結果" Style="{StaticResource PfSectionHeading}" /><TextBlock x:Name="PackResultText" Text="尚未計算。" TextWrapping="Wrap" FontSize="15" /><StackPanel x:Name="PackDiagramCanvas" Spacing="12"/></StackPanel></Border>
<Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="14" Padding="22">
 <StackPanel Spacing="13">
  <TextBlock Text="不規則空間配置最佳化 · LAYOUT EXPLORER" Style="{StaticResource PfSectionHeading}"/>
  <TextBlock Text="用多個不重疊的 XY 區域表示 L 形／階梯形空間，每區可設定不同 Z 厚度。電芯不能重疊、侵犯禁放區或超出區域。候選排列只是有界幾何搜尋，不是 CAD 製造或安規簽核。" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
  <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
   <StackPanel Spacing="11">
    <TextBlock Text="01 / 只要 L × W × H，先比較電芯配置" Style="{StaticResource PfSectionHeading}"/>
    <TextBlock Text="不需要 CAD 或 JSON。請填系統給的電池外框上限，以及候選電芯的規格；若不知道內部禁放區，這只是包絡預篩，不能宣稱已可製造。" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    <Button Content="填入完全虛構的尺寸範例" Click="QuickLayoutSampleClick" HorizontalAlignment="Left" MinHeight="38"/>
    <TextBlock Text="電池外框可用上限（mm）" FontWeight="SemiBold"/>
    <Grid ColumnSpacing="9" RowSpacing="8">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
