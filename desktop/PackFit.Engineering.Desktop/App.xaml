<Application
    x:Class="PackFit.Engineering.Desktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Use system fonts rather than shipping custom font files.
                 Windows 11: Segoe UI Variable; Traditional Chinese uses
                 the OS-script fallback (Microsoft JhengHei UI). -->
            <FontFamily x:Key="PfBodyFont">Segoe UI Variable Text</FontFamily>
            <FontFamily x:Key="PfHeadingFont">Segoe UI Variable Display</FontFamily>

            <Style x:Key="PfEyebrowText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource PfBodyFont}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="CharacterSpacing" Value="38"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style x:Key="PfPageHeading" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource PfHeadingFont}"/>
                <Setter Property="FontSize" Value="30"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style x:Key="PfSectionHeading" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource PfHeadingFont}"/>
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style x:Key="PfLeadText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource PfBodyFont}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Style>

            <Style x:Key="PfMetricValue" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource PfHeadingFont}"/>
                <Setter Property="FontSize" Value="22"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>